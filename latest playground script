        cam.radius = fullCamDistance;
        cam.target = new BABYLON.Vector3(0, 15, 0);
    };

    var setVase = function () {
        var cam = scene.activeCamera;
        cam.alpha = 0.8875
        cam.beta = 0.8383
        cam.radius = 63.39;
        cam.target = new BABYLON.Vector3(52.67, -32.50, 0.01);
    };

    setCamAnterior();

    return scene;
};
