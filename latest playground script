// latest playground version
function computeBoundingBoxCenter(meshes) {
    let min = new BABYLON.Vector3(Number.MAX_VALUE, Number.MAX_VALUE, Number.MAX_VALUE);
    let max = new BABYLON.Vector3(-Number.MAX_VALUE, -Number.MAX_VALUE, -Number.MAX_VALUE);

    meshes.forEach(mesh => {
        if (!mesh.getBoundingInfo) return;

        const boundingBox = mesh.getBoundingInfo().boundingBox;
        min = BABYLON.Vector3.Minimize(min, boundingBox.minimumWorld);
        max = BABYLON.Vector3.Maximize(max, boundingBox.maximumWorld);
    });

    return BABYLON.Vector3.Center(min, max);
}

var createConcreteGround = function (scene) {
    const ground = BABYLON.MeshBuilder.CreateGround("ground", {
    width: 500,
    height: 500
}, scene);
ground.receiveShadows = true;

// Create PBR material for concrete
const concretePBR = new BABYLON.PBRMaterial("concretePBR", scene);

// Base path to your GitHub-hosted files
const basePath = "https://raw.githubusercontent.com/Ionea/I-AM-DIGITAL/main/";

// Assign textures
concretePBR.albedoTexture = new BABYLON.Texture(basePath + "Concrete012_1K-PNG_Color.png", scene);
concretePBR.bumpTexture = new BABYLON.Texture(basePath + "Concrete012_1K-PNG_NormalGL.png", scene);
concretePBR.roughnessTexture = new BABYLON.Texture(basePath + "Concrete012_1K-PNG_Roughness.png", scene);
concretePBR.parallaxTexture = new BABYLON.Texture(basePath + "Concrete012_1K-PNG_Displacement.png", scene);

concretePBR.metallic = 0;                  // Concrete is non-metal
concretePBR.roughness = 1.0;               // Matte surface
concretePBR.parallaxScaleBias = 0.02;      // Subtle height effect

// Tile the texture to cover large surface naturally
const tiling = 5;
[
    concretePBR.albedoTexture,
    concretePBR.bumpTexture,
    concretePBR.roughnessTexture,
    concretePBR.parallaxTexture
].forEach(tex => {
    tex.uScale = tiling;
    tex.vScale = tiling;
});
concretePBR.environmentIntensity = 2; // 1 is default; lower = darker
concretePBR.albedoColor = new BABYLON.Color3(0.42, 0.42, 0.42, 0.78);
// Assign the material to the ground
ground.material = concretePBR;
    concretePBR.alpha = 0.6;

}

createGrid = function(scene){
    // Create the ground plane
    const ground = BABYLON.MeshBuilder.CreateGround("grid", { width: 500, height: 500 }, scene);

    // Create a grid material
    const gridMaterial = new BABYLON.GridMaterial("grid", scene);
    gridMaterial.majorUnitFrequency = 5;  // major grid line spacing
    gridMaterial.minorUnitVisibility = 0.45;
    gridMaterial.gridRatio = 5;         // size of each grid cell
    gridMaterial.backFaceCulling = false;
    gridMaterial.mainColor = new BABYLON.Color3(1, 1, 1); // white
    gridMaterial.lineColor = new BABYLON.Color3(0.5, 0.5, 0.5); // gray

    // Apply the material
    ground.material = gridMaterial;
    gridMaterial.opacity = 0.3;
}

